parameters:
    # Review level, from basic (1) to very thorough (9).
    level: 6
    # Source code directories to be reviewed.
    paths:
        - plugin
        - tests
    # plugin/admin's two pages load the Dolibarr environment through a
    # dynamic `@include` of main.inc.php (Dolibarr's own bootstrap idiom,
    # unavoidable for a standalone admin page): PHPStan can't see the
    # globals ($langs, $user, $db...) that file defines, so it flags every
    # use of them as possibly undefined. Reviewed by hand instead.
    excludePaths:
        - plugin/admin
    # The lowest PHP the plugin supports (also when run on a newer one).
    phpVersion: 70400
    # No official Dolibarr stubs package exists; this community one is the
    # closest equivalent, and only ships up to Dolibarr 23 (the plugin
    # targets 24): the closest version available.
    scanDirectories:
        - vendor/caprel/dolibarr-stubs-all/dolibarr-23
    # The constants the plugin uses directly, declared on their own
    # (phpstan-stubs.php): relying only on the scan above proved unreliable
    # in CI for these.
    scanFiles:
        - phpstan-stubs.php
    # Composer's autoloader.
    bootstrapFiles:
        - tests/bootstrap.php
