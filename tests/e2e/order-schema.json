{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["facture", "societe"],
  "properties": {
    "facture": {
      "type": "object",
      "required": ["id", "ref", "socid", "total_ttc", "statut", "paye"],
      "properties": {
        "id": { "type": ["integer", "string"] },
        "ref": { "type": "string" },
        "socid": { "type": ["integer", "string"] },
        "total_ttc": { "type": ["number", "string"] },
        "statut": { "type": ["integer", "string"] },
        "paye": { "type": ["integer", "string"] }
      },
      "not": { "required": ["db"] }
    },
    "societe": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": ["integer", "string"] },
        "name": { "type": "string" }
      },
      "not": { "required": ["db"] }
    }
  }
}
